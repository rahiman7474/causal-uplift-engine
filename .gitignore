*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
ENV*/

# Data files (Exclude raw and extracted heavy data files)
data/
*.csv
*.tsv
*.parquet
!artifacts/*.parquet
!artifacts/*.json
!artifacts/*.joblib

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE and Editor configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment variables
.env
.env.*

# ==============================================================================
# STREAMLIT COMMUNITY CLOUD REQUIREMENT:
# Explicitly keep artifacts/ tracked so Streamlit boots instantaneously without retraining.
# ==============================================================================
!artifacts/
!artifacts/**
